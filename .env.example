# Ключ Gemini API из Google AI Studio (https://aistudio.google.com/apikey).
# Хранится только на сервере, в браузер не попадает.
GEMINI_API_KEY=

# Необязательно: другая модель Gemini Flash (по умолчанию gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Необязательно: 1 — кнопки-примеры сразу показывают готовые отчёты без запроса к ИИ
# (мгновенно и без интернета — удобно на сцене).
# DEMO_CACHE_ONLY=1

# Необязательно: другой адрес Gemini API (прокси или тестовый сервер).
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Необязательно: запасное чтение сайтов, которые блокируют роботов или собираются скриптами,
# через Jina Reader (r.jina.ai). Без ключа — до 20 запросов в минуту. 0 — выключить.
# JINA_API_KEY=
# READER_FALLBACK=0
