# Ключ Gemini API из Google AI Studio (https://aistudio.google.com/apikey).
# Хранится только на сервере, в браузер не попадает.
GEMINI_API_KEY=

# Необязательно: другая модель Gemini Flash (по умолчанию gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Необязательно: другой адрес Gemini API (прокси или тестовый сервер).
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Необязательно: Google Safe Browsing как дополнительная база фишинга.
# SAFE_BROWSING_API_KEY=

# Необязательно: запасные модели Gemini через запятую, если основная перегружена.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Необязательно: Vercel Blob для жалоб пользователей на сайты и приложения.
# Без него всё работает, только без жалоб.
# BLOB_READ_WRITE_TOKEN=

# Необязательно: Telegram-бот (токен от @BotFather).
# TELEGRAM_BOT_TOKEN=

# Необязательно: ключ для служебных маршрутов (/api/telegram/setup, удаление жалоб).
# Без него эти маршруты выключены.
# ADMIN_KEY=

# Необязательно: сколько проверок в день разрешено одному IP (по умолчанию 40).
# DAILY_LIMIT_PER_IP=40
